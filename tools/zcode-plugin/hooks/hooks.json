{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/authoring-gate.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "stallion: judging the edit against the task lifecycle"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/banner.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "stallion: loading the live task state"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/banner.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "stallion: refreshing the task banner"
          }
        ]
      }
    ]
  }
}
